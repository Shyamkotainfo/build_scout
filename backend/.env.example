# BuildSmart — Environment Configuration Example
# Copy this file to .env and fill in your real values.

# LLM Configuration
GROQ_API_KEY=your-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# MCP Servers (Optional)
# If provided, the ResearchAgent will use these MCP servers via stdio.
# Example for GitHub MCP:
MCP_GITHUB_COMMAND="npx -y @modelcontextprotocol/server-github"
# GITHUB_PERSONAL_ACCESS_TOKEN is automatically used by the GitHub MCP server if set in the env.
GITHUB_PERSONAL_ACCESS_TOKEN="your_github_token"

# Example for Web Search MCP (e.g. Brave):
# MCP_WEB_COMMAND="npx -y @modelcontextprotocol/server-brave-search"
# BRAVE_API_KEY="your_brave_key"

# Lakebase Persistence Configuration (PostgreSQL Compatible)
LAKEBASE_HOST="your-lakebase-host.cloud.databricks.com"
LAKEBASE_PORT=5432
LAKEBASE_DATABASE="buildsmart_db"
LAKEBASE_USER="token"
LAKEBASE_PASSWORD="your-databricks-personal-access-token"
LAKEBASE_SSL_MODE="require"
